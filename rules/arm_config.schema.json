{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Window-scoped ARM configuration v4",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "aeroworld_arm_config"
    },
    "version": {
      "const": 4
    },
    "arm_id": {
      "type": "string",
      "pattern": "^arm_[a-z0-9_]+$"
    },
    "group_key": {
      "type": "string",
      "pattern": "^[^/]+/seed[0-9]+/[^/]+$"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "event_family": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "factual_observation",
        "intervention"
      ]
    },
    "entity_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "predicate_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_tick": {
          "type": "integer",
          "minimum": 0
        },
        "fork_tick": {
          "type": "integer",
          "minimum": 0
        },
        "end_tick": {
          "type": "integer",
          "minimum": 0
        },
        "phase": {
          "const": "after_state_sample_before_actions"
        },
        "intervention_order": {
          "const": "source_actions_then_intervention"
        }
      },
      "required": [
        "start_tick",
        "fork_tick",
        "end_tick",
        "phase",
        "intervention_order"
      ]
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scene": {
          "type": "string",
          "minLength": 1
        },
        "script": {
          "type": "string",
          "minLength": 1
        },
        "trajectories": {
          "type": "string",
          "minLength": 1
        },
        "weather": {
          "type": "string",
          "minLength": 1
        },
        "event_realization": {
          "type": "string",
          "minLength": 1
        },
        "predicate_transitions": {
          "type": "string",
          "minLength": 1
        },
        "event_outcomes": {
          "type": "string",
          "minLength": 1
        },
        "roster": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "scene",
        "script",
        "trajectories",
        "weather",
        "event_realization",
        "predicate_transitions",
        "event_outcomes",
        "roster"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "omit_action_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tick": {
                "type": "integer",
                "minimum": 0
              },
              "action": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "enum": [
                      "move_entity",
                      "set_runtime_state"
                    ]
                  },
                  "action_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "entity_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "velocity_mps": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "waypoints_enu_m": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "minItems": 1
                  },
                  "state_patch": {
                    "type": "object",
                    "minProperties": 1
                  },
                  "activity_type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "post_activity_type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "terminal_feasibility": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "landing_reference_enu_m": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 3,
                        "maxItems": 3
                      }
                    },
                    "required": [
                      "landing_reference_enu_m"
                    ]
                  }
                },
                "required": [
                  "type",
                  "action_id",
                  "entity_id"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "const": "move_entity"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "velocity_mps",
                        "waypoints_enu_m"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "const": "set_runtime_state"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "state_patch"
                      ]
                    }
                  }
                ]
              }
            },
            "required": [
              "tick",
              "action"
            ]
          }
        },
        "trigger_rewrites": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "trigger_id": {
                "type": "string",
                "minLength": 1
              },
              "delay_ticks": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60
              },
              "mechanism": {
                "enum": [
                  "tick_shift",
                  "min_true_ticks_shift",
                  "fired_after_delay_shift"
                ]
              }
            },
            "required": [
              "trigger_id",
              "delay_ticks",
              "mechanism"
            ]
          }
        }
      },
      "required": [
        "omit_action_ids",
        "actions"
      ]
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_event": {
          "enum": [
            "absent_in_window",
            "occurs",
            "observe"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "falsified_if": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "target_event",
        "rationale",
        "falsified_if"
      ]
    },
    "script": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "experiment_ref": {
          "type": "string",
          "minLength": 1
        },
        "parameter_sources": {
          "type": "object",
          "minProperties": 1,
          "required": [
            "factual_root"
          ],
          "properties": {
            "factual_root": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        }
      },
      "required": [
        "experiment_ref",
        "parameter_sources"
      ]
    }
  },
  "required": [
    "schema",
    "version",
    "arm_id",
    "group_key",
    "episode_id",
    "event_family",
    "mode",
    "entity_ids",
    "predicate_ids",
    "window",
    "sources",
    "execution",
    "expected",
    "script",
    "output",
    "provenance"
  ]
}
