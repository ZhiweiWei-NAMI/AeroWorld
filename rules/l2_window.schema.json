{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "L2 event-chain window ARM configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "aeroworld_l2_window_config"
    },
    "version": {
      "const": 1
    },
    "arm_id": {
      "type": "string",
      "pattern": "^arm_[a-z0-9_]+$"
    },
    "group_key": {
      "type": "string",
      "pattern": "^[^/]+/seed[0-9]+/[^/]+$"
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "enum": [
        "seed00",
        "seed01",
        "seed02"
      ]
    },
    "anchor_event": {
      "type": "string",
      "minLength": 1
    },
    "target_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mode": {
      "enum": [
        "factual_observation",
        "intervention"
      ]
    },
    "entity_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "predicate_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_tick",
        "fork_tick",
        "end_tick",
        "phase",
        "intervention_order"
      ],
      "properties": {
        "start_tick": {
          "type": "integer",
          "minimum": 0
        },
        "fork_tick": {
          "type": "integer",
          "minimum": 0
        },
        "end_tick": {
          "type": "integer",
          "minimum": 0
        },
        "phase": {
          "const": "after_state_sample_before_actions"
        },
        "intervention_order": {
          "const": "source_actions_then_intervention"
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene",
        "script",
        "trajectories",
        "weather",
        "roster"
      ],
      "properties": {
        "scene": {
          "type": "string",
          "minLength": 1
        },
        "script": {
          "type": "string",
          "minLength": 1
        },
        "trajectories": {
          "type": "string",
          "minLength": 1
        },
        "weather": {
          "type": "string",
          "minLength": 1
        },
        "roster": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "omit_action_ids",
        "actions"
      ],
      "properties": {
        "omit_action_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tick",
              "action"
            ],
            "properties": {
              "tick": {
                "type": "integer",
                "minimum": 0
              },
              "action": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "action_id",
                  "entity_id"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "move_entity",
                      "set_runtime_state",
                      "set_visual_state"
                    ]
                  },
                  "visual_state": {
                    "type": "object",
                    "properties": {
                      "mode": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "mode"
                    ],
                    "additionalProperties": false
                  },
                  "action_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "entity_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "delay_ticks": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "velocity_mps": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "waypoints_enu_m": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    }
                  },
                  "state_patch": {
                    "type": "object",
                    "minProperties": 1
                  },
                  "activity_type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "post_activity_type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "terminal_feasibility": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "landing_reference_enu_m": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 3,
                        "maxItems": 3
                      }
                    },
                    "required": [
                      "landing_reference_enu_m"
                    ]
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "enum": [
                            "move_entity",
                            "set_visual_state"
                          ]
                        }
                      },
                      "required": [
                        "type"
                      ]
                    },
                    "then": {
                      "not": {
                        "required": [
                          "state_patch"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_event",
        "rationale",
        "falsified_if"
      ],
      "properties": {
        "target_event": {
          "enum": [
            "absent_in_window",
            "occurs",
            "observe"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "falsified_if": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "script": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": "string",
      "minLength": 1
    },
    "experiment": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_ref",
        "parameter_sources"
      ],
      "properties": {
        "experiment_ref": {
          "type": "string",
          "minLength": 1
        },
        "parameter_sources": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true,
          "required": [
            "factual_root"
          ],
          "properties": {
            "factual_root": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "required": [
    "schema",
    "version",
    "arm_id",
    "group_key",
    "episode_id",
    "profile",
    "seed",
    "anchor_event",
    "target_families",
    "mode",
    "entity_ids",
    "predicate_ids",
    "window",
    "sources",
    "execution",
    "expected",
    "script",
    "output",
    "experiment",
    "provenance"
  ]
}
