{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "L5 authored-scene candidate ARM v1",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "arm_id": {
   "type": "string",
   "minLength": 1
  },
  "group_key": {
   "type": "string",
   "minLength": 1
  },
  "episode_id": {
   "type": "string",
   "minLength": 1
  },
  "primary_entity_id": {
   "type": "string",
   "minLength": 1
  },
  "operational_region_id": {
   "type": "string",
   "minLength": 1
  },
  "script": {
   "type": "string",
   "minLength": 1
  },
  "output": {
   "type": "string",
   "minLength": 1
  },
  "schema": {
   "const": "aeroworld_l5_candidate_arm_config"
  },
  "version": {
   "const": 1
  },
  "status": {
   "const": "candidate_pending_owner_revalidation"
  },
  "seed": {
   "type": "integer",
   "minimum": 0,
   "maximum": 2
  },
  "mode": {
   "enum": [
    "factual_observation",
    "intervention"
   ]
  },
  "entity_ids": {
   "type": "array",
   "uniqueItems": true,
   "items": {
    "type": "string",
    "minLength": 1
   },
   "minItems": 1
  },
  "semantic_pedestrian_ids": {
   "type": "array",
   "uniqueItems": true,
   "items": {
    "type": "string",
    "minLength": 1
   }
  },
  "runtime_state_families": {
   "type": "array",
   "uniqueItems": true,
   "items": {
    "type": "string",
    "minLength": 1
   },
   "minItems": 1
  },
  "event_families": {
   "type": "array",
   "uniqueItems": true,
   "items": {
    "type": "string",
    "minLength": 1
   },
   "minItems": 1
  },
  "predicate_ids": {
   "type": "array",
   "uniqueItems": true,
   "items": {
    "type": "string",
    "minLength": 1
   },
   "minItems": 1
  },
  "blocked_event_families": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "event_family_id": {
      "type": "string"
     },
     "status": {
      "const": "blocked"
     },
     "reason": {
      "type": "string",
      "minLength": 1
     },
     "missing": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string"
      }
     }
    },
    "required": [
     "event_family_id",
     "status",
     "reason",
     "missing"
    ]
   }
  },
  "window": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "start_tick": {
     "type": "integer",
     "minimum": 0
    },
    "fork_tick": {
     "type": "integer",
     "minimum": 1
    },
    "end_tick": {
     "type": "integer",
     "minimum": 1,
     "maximum": 900
    },
    "phase": {
     "const": "after_state_sample_before_actions"
    },
    "intervention_order": {
     "const": "source_actions_then_intervention"
    }
   },
   "required": [
    "start_tick",
    "fork_tick",
    "end_tick",
    "phase",
    "intervention_order"
   ],
   "description": "Inclusive formal-grid window [start_tick,end_tick] cut to the branch under study; fork_tick is the anchor dispatch tick. The engine still replays from tick 0; only [start_tick,end_tick] is recorded and reported."
  },
  "sources": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "scene": {
     "type": "string",
     "minLength": 1
    },
    "script": {
     "type": "string",
     "minLength": 1
    },
    "trajectories": {
     "type": "string",
     "minLength": 1
    },
    "weather": {
     "type": "string",
     "minLength": 1
    },
    "roster": {
     "type": "string",
     "minLength": 1
    },
    "event_realization": {
     "type": "string",
     "minLength": 1
    },
    "event_trace": {
     "type": "string",
     "minLength": 1
    },
    "episode_manifest": {
     "type": "string",
     "minLength": 1
    },
    "scenario_plan": {
     "type": "string",
     "minLength": 1
    },
    "event_occurrences": {
     "type": "string",
     "minLength": 1
    },
    "event_outcomes": {
     "type": "string",
     "minLength": 1
    },
    "predicate_transitions": {
     "type": "string",
     "minLength": 1
    },
    "semantic_manifest": {
     "type": "string",
     "minLength": 1
    },
    "runtime_schedule": {
     "type": "string",
     "minLength": 1
    }
   },
   "required": [
    "scene",
    "script",
    "trajectories",
    "weather",
    "roster",
    "event_realization",
    "event_trace",
    "episode_manifest",
    "scenario_plan",
    "event_occurrences",
    "event_outcomes",
    "predicate_transitions",
    "semantic_manifest",
    "runtime_schedule"
   ]
  },
  "execution": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "omit_action_ids": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "actions": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "tick": {
        "type": "integer",
        "minimum": 1,
        "maximum": 899
       },
       "action": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
         "type": {
          "const": "set_weather"
         },
         "action_id": {
          "type": "string",
          "minLength": 1
         },
         "profile": {
          "type": "string",
          "minLength": 1
         },
         "overrides": {
          "type": "object",
          "minProperties": 1
         }
        },
        "required": [
         "type",
         "action_id",
         "profile",
         "overrides"
        ]
       }
      },
      "required": [
       "tick",
       "action"
      ]
     }
    }
   },
   "required": [
    "omit_action_ids",
    "actions"
   ]
  },
  "expected": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "target_event": {
     "type": "string",
     "minLength": 1
    },
    "rationale": {
     "type": "string",
     "minLength": 1
    },
    "falsified_if": {
     "type": "string",
     "minLength": 1
    }
   },
   "required": [
    "target_event",
    "rationale",
    "falsified_if"
   ]
  },
  "provenance": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "experiment_ref": {
     "type": "string"
    },
    "parameter_sources": {
     "type": "object",
     "minProperties": 1
    }
   },
   "required": [
    "experiment_ref",
    "parameter_sources"
   ]
  }
 },
 "required": [
  "arm_id",
  "group_key",
  "episode_id",
  "primary_entity_id",
  "operational_region_id",
  "script",
  "output",
  "schema",
  "version",
  "status",
  "seed",
  "mode",
  "entity_ids",
  "semantic_pedestrian_ids",
  "runtime_state_families",
  "event_families",
  "predicate_ids",
  "blocked_event_families",
  "window",
  "sources",
  "execution",
  "expected",
  "provenance"
 ]
}
