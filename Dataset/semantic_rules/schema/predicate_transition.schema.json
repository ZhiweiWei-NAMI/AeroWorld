{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeroworld.local/schema/predicate_transition.schema.json",
  "title": "Predicate transition record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "annotation_layer",
    "source_layer",
    "materialization_policy",
    "transition_id",
    "episode_id",
    "predicate_id",
    "tuple_id",
    "bindings",
    "from_tick",
    "to_tick",
    "from_value",
    "to_value",
    "direction",
    "evidence_truth_ids",
    "source_refs"
  ],
  "properties": {
    "schema_name": {
      "const": "predicate_transition"
    },
    "schema_version": {
      "const": "3.0.0"
    },
    "annotation_layer": {
      "const": "L1"
    },
    "source_layer": {
      "const": "L0"
    },
    "materialization_policy": {
      "const": "predicate_delta"
    },
    "transition_id": {
      "type": "string"
    },
    "episode_id": {
      "type": "string"
    },
    "predicate_id": {
      "type": "string"
    },
    "tuple_id": {
      "type": "string"
    },
    "bindings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "from_tick": {
      "type": "integer"
    },
    "to_tick": {
      "type": "integer"
    },
    "from_value": {
      "enum": [
        "true",
        "false"
      ]
    },
    "to_value": {
      "enum": [
        "true",
        "false"
      ]
    },
    "direction": {
      "enum": [
        "rising",
        "falling"
      ]
    },
    "evidence_truth_ids": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string"
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "template_parameters": {
      "type": "object"
    }
  }
}
