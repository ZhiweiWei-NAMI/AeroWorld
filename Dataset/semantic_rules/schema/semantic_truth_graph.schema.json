{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aeroworld.local/schema/semantic_truth_graph.schema.json",
  "title": "Semantic truth graph at an authoritative tick",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_name",
    "schema_version",
    "episode_id",
    "tick",
    "graph_id",
    "graph_digest",
    "changed_from_previous",
    "added_assertion_ids",
    "removed_assertion_ids",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_name": {
      "const": "semantic_truth_graph"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "episode_id": {
      "type": "string"
    },
    "tick": {
      "type": "integer"
    },
    "graph_id": {
      "type": "string"
    },
    "graph_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "changed_from_previous": {
      "type": "boolean"
    },
    "added_assertion_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "removed_assertion_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "entity",
              "event"
            ]
          },
          "event_type_id": {
            "type": "string"
          },
          "entity_category": {
            "type": "string"
          },
          "entity_kind": {
            "type": "string"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assertion_id",
          "kind",
          "label",
          "bindings",
          "evidence_refs"
        ],
        "properties": {
          "assertion_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "predicate",
              "event_participant"
            ]
          },
          "label": {
            "type": "string"
          },
          "truth_value": {
            "enum": [
              "true",
              "false",
              "unknown",
              "out_of_scope"
            ]
          },
          "bindings": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string"
            }
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "event_participant"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "truth_value"
                ]
              }
            },
            "else": {
              "required": [
                "truth_value"
              ]
            }
          }
        ]
      }
    }
  }
}
