    ] .

shape:CrowdEvacuationEventExactParticipantRolesShape
    a sh:NodeShape ;
    sh:targetNode evt:CrowdEvacuationEvent ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( evt:CrowdEvacuationEventRole_crowd )
    ] .
