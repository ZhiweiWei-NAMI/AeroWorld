    a sh:NodeShape ;
    sh:targetNode evt:AircraftGroundVehicleCollisionEvent ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:in ( evt:AircraftGroundVehicleCollisionEventRole_aircraft evt:AircraftGroundVehicleCollisionEventRole_vehicle )
    ] .

shape:AircraftGroundVehicleConflictEventExactParticipantRolesShape
    a sh:NodeShape ;
    sh:targetNode evt:AircraftGroundVehicleConflictEvent ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:in ( evt:AircraftGroundVehicleConflictEventRole_aircraft evt:AircraftGroundVehicleConflictEventRole_vehicle )
    ] .

shape:AircraftPedestrianNearMissEventExactParticipantRolesShape
    a sh:NodeShape ;
    sh:targetNode evt:AircraftPedestrianNearMissEvent ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
        sh:minCount 2 ;
