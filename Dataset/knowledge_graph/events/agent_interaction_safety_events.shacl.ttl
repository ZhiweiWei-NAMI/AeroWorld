        sh:in ( evt:AircraftPedestrianNearMissEventRole_aircraft evt:AircraftPedestrianNearMissEventRole_pedestrian )
    ] .

shape:PedestrianVehicleConflictEventExactParticipantRolesShape
    a sh:NodeShape ;
    sh:targetNode evt:PedestrianVehicleConflictEvent ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
