@prefix aw: <https://w3id.org/aeroworld/ontology/core#> .
@prefix world: <https://w3id.org/aeroworld/ontology/world#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@prefix evt: <https://w3id.org/aeroworld/ontology/events/computation_process#> .
@prefix shape: <https://w3id.org/aeroworld/ontology/events/computation_process/shapes#> .

<https://w3id.org/aeroworld/ontology/events/computation_process/shapes>
    a owl:Ontology ;
    owl:imports <https://w3id.org/aeroworld/ontology/events/computation_process> ;
    owl:versionInfo "0.3.0" .

shape:StableEventTypeShape
    a sh:NodeShape ;
    sh:targetClass aw:EventType ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        sh:path aw:eventTypeIdentifier ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
        sh:class aw:ParticipantRole ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 2 ;
        sh:uniqueLang true
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 2 ;
        sh:uniqueLang true
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "One event type cannot declare duplicate participant-role keys."@en ;
        sh:select """
            SELECT $this
            WHERE {
                $this aw:declaresParticipantRole ?left, ?right .
                ?left aw:participantRoleKey ?key .
                ?right aw:participantRoleKey ?key .
                FILTER (?left != ?right)
            }
        """
    ] .

shape:CompleteParticipantRoleShape
    a sh:NodeShape ;
    sh:targetObjectsOf aw:declaresParticipantRole ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        sh:path aw:participantRoleKey ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path world:participantClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1
    ] .

shape:ComputeTaskOffloadEventExactParticipantRolesShape
    a sh:NodeShape ;
    sh:targetNode evt:ComputeTaskOffloadEvent ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
        sh:minCount 4 ;
        sh:maxCount 4 ;
        sh:in ( evt:ComputeTaskOffloadEventRole_offload evt:ComputeTaskOffloadEventRole_task evt:ComputeTaskOffloadEventRole_source_node evt:ComputeTaskOffloadEventRole_target_node )
    ] .

shape:ComputeTaskMigrationEventExactParticipantRolesShape
    a sh:NodeShape ;
    sh:targetNode evt:ComputeTaskMigrationEvent ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
        sh:minCount 4 ;
        sh:maxCount 4 ;
        sh:in ( evt:ComputeTaskMigrationEventRole_migration evt:ComputeTaskMigrationEventRole_task evt:ComputeTaskMigrationEventRole_source_node evt:ComputeTaskMigrationEventRole_target_node )
    ] .

shape:ComputeTaskExecutionFailureEventExactParticipantRolesShape
    a sh:NodeShape ;
    sh:targetNode evt:ComputeTaskExecutionFailureEvent ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
        sh:minCount 4 ;
        sh:maxCount 4 ;
        sh:in ( evt:ComputeTaskExecutionFailureEventRole_execution evt:ComputeTaskExecutionFailureEventRole_task evt:ComputeTaskExecutionFailureEventRole_node evt:ComputeTaskExecutionFailureEventRole_failure_state )
    ] .

shape:ComputeResourceSaturationEventExactParticipantRolesShape
    a sh:NodeShape ;
    sh:targetNode evt:ComputeResourceSaturationEvent ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:in ( evt:ComputeResourceSaturationEventRole_node evt:ComputeResourceSaturationEventRole_resource )
    ] .

shape:ComputeQueueOverloadEventExactParticipantRolesShape
    a sh:NodeShape ;
    sh:targetNode evt:ComputeQueueOverloadEvent ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:in ( evt:ComputeQueueOverloadEventRole_queue evt:ComputeQueueOverloadEventRole_node )
    ] .
