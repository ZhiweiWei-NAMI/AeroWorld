@prefix aw: <https://w3id.org/aeroworld/ontology/core#> .
@prefix world: <https://w3id.org/aeroworld/ontology/world#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@prefix evt: <https://w3id.org/aeroworld/ontology/events/ground_mobility#> .
@prefix shape: <https://w3id.org/aeroworld/ontology/events/ground_mobility/shapes#> .

<https://w3id.org/aeroworld/ontology/events/ground_mobility/shapes>
    a owl:Ontology ;
    owl:imports <https://w3id.org/aeroworld/ontology/events/ground_mobility> ;
    owl:versionInfo "0.3.0" .

shape:StableEventTypeShape
    a sh:NodeShape ;
    sh:targetClass aw:EventType ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        sh:path aw:eventTypeIdentifier ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
        sh:class aw:ParticipantRole ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 2 ;
        sh:uniqueLang true
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 2 ;
        sh:uniqueLang true
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "One event type cannot declare duplicate participant-role keys."@en ;
        sh:select """
            SELECT $this
            WHERE {
                $this aw:declaresParticipantRole ?left, ?right .
                ?left aw:participantRoleKey ?key .
                ?right aw:participantRoleKey ?key .
                FILTER (?left != ?right)
            }
        """
    ] .

shape:CompleteParticipantRoleShape
    a sh:NodeShape ;
    sh:targetObjectsOf aw:declaresParticipantRole ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        sh:path aw:participantRoleKey ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path world:participantClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1
    ] .

shape:RoadConstructionDetourEventExactParticipantRolesShape
    a sh:NodeShape ;
    sh:targetNode evt:RoadConstructionDetourEvent ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:in ( evt:RoadConstructionDetourEventRole_road_segment evt:RoadConstructionDetourEventRole_barrier )
    ] .

shape:RoadSegmentClosureEventExactParticipantRolesShape
    a sh:NodeShape ;
    sh:targetNode evt:RoadSegmentClosureEvent ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( evt:RoadSegmentClosureEventRole_road_segment )
    ] .

shape:TrafficSignalMalfunctionEventExactParticipantRolesShape
    a sh:NodeShape ;
    sh:targetNode evt:TrafficSignalMalfunctionEvent ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( evt:TrafficSignalMalfunctionEventRole_signal )
    ] .

shape:GroundVehicleCollisionEventExactParticipantRolesShape
    a sh:NodeShape ;
    sh:targetNode evt:GroundVehicleCollisionEvent ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:in ( evt:GroundVehicleCollisionEventRole_first_vehicle evt:GroundVehicleCollisionEventRole_second_vehicle )
    ] .

shape:VehicleBreakdownRoadBlockEventExactParticipantRolesShape
    a sh:NodeShape ;
    sh:targetNode evt:VehicleBreakdownRoadBlockEvent ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:in ( evt:VehicleBreakdownRoadBlockEventRole_disabled_vehicle evt:VehicleBreakdownRoadBlockEventRole_road_element )
    ] .
