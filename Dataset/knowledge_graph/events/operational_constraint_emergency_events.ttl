@prefix aw: <https://w3id.org/aeroworld/ontology/core#> .
@prefix world: <https://w3id.org/aeroworld/ontology/world#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@prefix evt: <https://w3id.org/aeroworld/ontology/events/operational_constraint_emergency#> .
@prefix dom: <https://w3id.org/aeroworld/ontology/domain/operational_constraint_emergency#> .

<https://w3id.org/aeroworld/ontology/events/operational_constraint_emergency>
    a owl:Ontology ;
    owl:versionIRI <https://w3id.org/aeroworld/ontology/events/operational_constraint_emergency/0.3.0> ;
    owl:versionInfo "0.3.0" ;
    owl:imports <https://w3id.org/aeroworld/ontology/world> ,
        <https://w3id.org/aeroworld/ontology/domain/operational_constraint_emergency> ;
    dct:title "AeroWorld Operational Constraint and Emergency Event Ontology"@en ,
        "AeroWorld 运行约束与应急事件本体"@zh ;
    dct:description "Objective temporary restriction, emergency isolation, and medical emergency event families."@en ,
        "既有临时限制、应急隔离和医疗应急事件族。"@zh ;
    dct:creator "AeroWorld Project" ;
    dct:created "2026-07-30"^^xsd:date ;
    vann:preferredNamespacePrefix "evt" ;
    vann:preferredNamespaceUri "https://w3id.org/aeroworld/ontology/events/operational_constraint_emergency#" .

#################################################################
# Stable objective event types and complete participant roles
#################################################################

evt:TemporaryNoFlyZoneActivationEventRole_constraint
    a aw:ParticipantRole ;
    aw:participantRoleKey "constraint" ;
    world:participantClass dom:TemporaryRestriction ;
    rdfs:label "constraint"@en .

evt:TemporaryNoFlyZoneActivationEventRole_region
    a aw:ParticipantRole ;
    aw:participantRoleKey "region" ;
    world:participantClass world:NoFlyZone ;
    rdfs:label "region"@en .

evt:TemporaryNoFlyZoneActivationEvent
    a aw:EventType ;
    aw:eventTypeIdentifier "emergency.temporary_no_fly_zone_activation_event" ;
    aw:declaresParticipantRole evt:TemporaryNoFlyZoneActivationEventRole_constraint ,
        evt:TemporaryNoFlyZoneActivationEventRole_region ;
    rdfs:label "temporary no-fly zone activation"@en ,
        "临时禁飞区激活事件"@zh ;
    skos:definition "Objective event in which a temporary no-fly zone becomes active."@en ,
        "临时禁飞区激活的客观事件"@zh .

evt:EmergencyIsolationZoneEventRole_zone
    a aw:ParticipantRole ;
    aw:participantRoleKey "zone" ;
    world:participantClass dom:EmergencyIsolationZone ;
    rdfs:label "zone"@en .

evt:EmergencyIsolationZoneEventRole_response
    a aw:ParticipantRole ;
    aw:participantRoleKey "response" ;
    world:participantClass dom:EmergencyResponse ;
    rdfs:label "response"@en .

evt:EmergencyIsolationZoneEvent
    a aw:EventType ;
    aw:eventTypeIdentifier "emergency.emergency_isolation_zone_event" ;
    aw:declaresParticipantRole evt:EmergencyIsolationZoneEventRole_zone ,
        evt:EmergencyIsolationZoneEventRole_response ;
    rdfs:label "emergency isolation zone"@en ,
        "应急隔离区事件"@zh ;
    skos:definition "Objective event in which an emergency isolation zone is active."@en ,
        "应急隔离区激活的客观事件"@zh .

evt:HazmatEmergencyResponseEventRole_hazard
    a aw:ParticipantRole ;
    aw:participantRoleKey "hazard" ;
    world:participantClass world:HazardSource ;
    rdfs:label "hazard"@en .

evt:HazmatEmergencyResponseEventRole_response
    a aw:ParticipantRole ;
    aw:participantRoleKey "response" ;
    world:participantClass dom:EmergencyResponse ;
    rdfs:label "response"@en .

evt:HazmatEmergencyResponseEvent
    a aw:EventType ;
    aw:eventTypeIdentifier "emergency.hazmat_response_event" ;
    aw:declaresParticipantRole evt:HazmatEmergencyResponseEventRole_hazard ,
        evt:HazmatEmergencyResponseEventRole_response ;
    rdfs:label "hazmat emergency response"@en ,
        "危化品应急响应事件"@zh ;
    skos:definition "Objective event in which a hazardous material release triggers isolation, responder handoff, and resolution."@en ,
        "危化品释放触发隔离、应急交接和处置完成的客观事件"@zh .

evt:PedestrianMedicalEmergencyEventRole_pedestrian
    a aw:ParticipantRole ;
    aw:participantRoleKey "pedestrian" ;
    world:participantClass world:Pedestrian ;
    rdfs:label "pedestrian"@en .

evt:PedestrianMedicalEmergencyEventRole_response
    a aw:ParticipantRole ;
    aw:participantRoleKey "response" ;
    world:participantClass dom:EmergencyResponse ;
    rdfs:label "response"@en .

evt:PedestrianMedicalEmergencyEvent
    a aw:EventType ;
    aw:eventTypeIdentifier "emergency.pedestrian_medical_emergency_event" ;
    aw:declaresParticipantRole evt:PedestrianMedicalEmergencyEventRole_pedestrian ,
        evt:PedestrianMedicalEmergencyEventRole_response ;
    rdfs:label "pedestrian medical emergency"@en ,
        "行人医疗应急事件"@zh ;
    skos:definition "Objective event in which a pedestrian fall or medical emergency triggers response."@en ,
        "行人跌倒或医疗应急触发响应的客观事件"@zh .
