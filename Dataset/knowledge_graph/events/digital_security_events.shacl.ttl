@prefix aw: <https://w3id.org/aeroworld/ontology/core#> .
@prefix world: <https://w3id.org/aeroworld/ontology/world#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@prefix evt: <https://w3id.org/aeroworld/ontology/events/digital_security#> .
@prefix shape: <https://w3id.org/aeroworld/ontology/events/digital_security/shapes#> .

<https://w3id.org/aeroworld/ontology/events/digital_security/shapes>
    a owl:Ontology ;
    owl:imports <https://w3id.org/aeroworld/ontology/events/digital_security> ;
    owl:versionInfo "0.3.0" .

shape:StableEventTypeShape
    a sh:NodeShape ;
    sh:targetClass aw:EventType ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        sh:path aw:eventTypeIdentifier ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
        sh:class aw:ParticipantRole ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 2 ;
        sh:uniqueLang true
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 2 ;
        sh:uniqueLang true
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "One event type cannot declare duplicate participant-role keys."@en ;
        sh:select """
            SELECT $this
            WHERE {
                $this aw:declaresParticipantRole ?left, ?right .
                ?left aw:participantRoleKey ?key .
                ?right aw:participantRoleKey ?key .
                FILTER (?left != ?right)
            }
        """
    ] .

shape:CompleteParticipantRoleShape
    a sh:NodeShape ;
    sh:targetObjectsOf aw:declaresParticipantRole ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        sh:path aw:participantRoleKey ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path world:participantClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1
    ] .

shape:GroundControlStationCompromiseEventExactParticipantRolesShape
    a sh:NodeShape ;
    sh:targetNode evt:GroundControlStationCompromiseEvent ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( evt:GroundControlStationCompromiseEventRole_station )
    ] .

shape:UnauthorizedCommandEventExactParticipantRolesShape
    a sh:NodeShape ;
    sh:targetNode evt:UnauthorizedCommandEvent ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:in ( evt:UnauthorizedCommandEventRole_actor evt:UnauthorizedCommandEventRole_command )
    ] .

shape:CommunicationJammingImpactEventExactParticipantRolesShape
    a sh:NodeShape ;
    sh:targetNode evt:CommunicationJammingImpactEvent ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:in ( evt:CommunicationJammingImpactEventRole_actor evt:CommunicationJammingImpactEventRole_station )
    ] .

shape:ControlCommandIntegrityViolationEventExactParticipantRolesShape
    a sh:NodeShape ;
    sh:targetNode evt:ControlCommandIntegrityViolationEvent ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( evt:ControlCommandIntegrityViolationEventRole_stream )
    ] .

shape:SecurityControlUnavailabilityEventExactParticipantRolesShape
    a sh:NodeShape ;
    sh:targetNode evt:SecurityControlUnavailabilityEvent ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( evt:SecurityControlUnavailabilityEventRole_control )
    ] .
