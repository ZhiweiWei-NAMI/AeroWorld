@prefix aw: <https://w3id.org/aeroworld/ontology/core#> .
@prefix world: <https://w3id.org/aeroworld/ontology/world#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@prefix evt: <https://w3id.org/aeroworld/ontology/events/mobility_regulation#> .
@prefix shape: <https://w3id.org/aeroworld/ontology/events/mobility_regulation/shapes#> .

<https://w3id.org/aeroworld/ontology/events/mobility_regulation/shapes>
    a owl:Ontology ;
    owl:imports <https://w3id.org/aeroworld/ontology/events/mobility_regulation> ;
    owl:versionInfo "0.3.0" .

shape:StableEventTypeShape
    a sh:NodeShape ;
    sh:targetClass aw:EventType ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        sh:path aw:eventTypeIdentifier ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
        sh:class aw:ParticipantRole ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 2 ;
        sh:uniqueLang true
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 2 ;
        sh:uniqueLang true
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "One event type cannot declare duplicate participant-role keys."@en ;
        sh:select """
            SELECT $this
            WHERE {
                $this aw:declaresParticipantRole ?left, ?right .
                ?left aw:participantRoleKey ?key .
                ?right aw:participantRoleKey ?key .
                FILTER (?left != ?right)
            }
        """
    ] .

shape:CompleteParticipantRoleShape
    a sh:NodeShape ;
    sh:targetObjectsOf aw:declaresParticipantRole ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        sh:path aw:participantRoleKey ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path world:participantClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1
    ] .

shape:EmergencyVehiclePriorityPassageEventExactParticipantRolesShape
    a sh:NodeShape ;
    sh:targetNode evt:EmergencyVehiclePriorityPassageEvent ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:in ( evt:EmergencyVehiclePriorityPassageEventRole_emergency_vehicle evt:EmergencyVehiclePriorityPassageEventRole_right_of_way )
    ] .

shape:RedSignalViolationEventExactParticipantRolesShape
    a sh:NodeShape ;
    sh:targetNode evt:RedSignalViolationEvent ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
        sh:minCount 3 ;
        sh:maxCount 3 ;
        sh:in ( evt:RedSignalViolationEventRole_vehicle evt:RedSignalViolationEventRole_signal evt:RedSignalViolationEventRole_regulation )
    ] .

shape:SpeedLimitViolationEventExactParticipantRolesShape
    a sh:NodeShape ;
    sh:targetNode evt:SpeedLimitViolationEvent ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:in ( evt:SpeedLimitViolationEventRole_vehicle evt:SpeedLimitViolationEventRole_regulation )
    ] .

shape:RightOfWayViolationEventExactParticipantRolesShape
    a sh:NodeShape ;
    sh:targetNode evt:RightOfWayViolationEvent ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:in ( evt:RightOfWayViolationEventRole_actor evt:RightOfWayViolationEventRole_right_of_way )
    ] .

shape:FollowingDistanceViolationEventExactParticipantRolesShape
    a sh:NodeShape ;
    sh:targetNode evt:FollowingDistanceViolationEvent ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
        sh:minCount 3 ;
        sh:maxCount 3 ;
        sh:in ( evt:FollowingDistanceViolationEventRole_following_vehicle evt:FollowingDistanceViolationEventRole_leading_vehicle evt:FollowingDistanceViolationEventRole_rule )
    ] .

shape:LaneUseViolationEventExactParticipantRolesShape
    a sh:NodeShape ;
    sh:targetNode evt:LaneUseViolationEvent ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
        sh:minCount 3 ;
        sh:maxCount 3 ;
        sh:in ( evt:LaneUseViolationEventRole_actor evt:LaneUseViolationEventRole_lane evt:LaneUseViolationEventRole_restriction )
    ] .

shape:CrosswalkYieldViolationEventExactParticipantRolesShape
    a sh:NodeShape ;
    sh:targetNode evt:CrosswalkYieldViolationEvent ;
    sh:property [
        sh:path aw:declaresParticipantRole ;
        sh:minCount 3 ;
        sh:maxCount 3 ;
        sh:in ( evt:CrosswalkYieldViolationEventRole_vehicle evt:CrosswalkYieldViolationEventRole_pedestrian evt:CrosswalkYieldViolationEventRole_obligation )
    ] .
