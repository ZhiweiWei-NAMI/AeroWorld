@prefix aw: <https://w3id.org/aeroworld/ontology/core#> .
@prefix world: <https://w3id.org/aeroworld/ontology/world#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@prefix dom: <https://w3id.org/aeroworld/ontology/domain/airspace_operations#> .
@prefix shape: <https://w3id.org/aeroworld/ontology/domain/airspace_operations/shapes#> .

<https://w3id.org/aeroworld/ontology/domain/airspace_operations/shapes>
    a owl:Ontology ;
    owl:imports <https://w3id.org/aeroworld/ontology/domain/airspace_operations> ;
    owl:versionInfo "0.3.0" .

shape:PredicateSignatureShape
    a sh:NodeShape ;
    sh:targetClass aw:PredicateType ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        sh:path aw:predicateIdentifier ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path aw:declaresArgumentRole ;
        sh:class aw:ArgumentRole ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 2 ;
        sh:uniqueLang true
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 2 ;
        sh:uniqueLang true
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "One predicate cannot declare duplicate argument-role keys."@en ;
        sh:select """
            SELECT $this
            WHERE {
                $this aw:declaresArgumentRole ?left, ?right .
                ?left aw:argumentRoleKey ?key .
                ?right aw:argumentRoleKey ?key .
                FILTER (?left != ?right)
            }
        """
    ] .

shape:ArgumentRoleShape
    a sh:NodeShape ;
    sh:targetObjectsOf aw:declaresArgumentRole ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        sh:path aw:argumentRoleKey ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path world:argumentClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1
    ] .

shape:DomainClassShape
    a sh:NodeShape ;
    sh:targetSubjectsOf rdfs:subClassOf ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 2 ;
        sh:uniqueLang true
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 2 ;
        sh:uniqueLang true
    ] .

shape:DomainRelationShape
    a sh:NodeShape ;
    sh:targetClass owl:ObjectProperty ;
    sh:property [
        sh:path rdfs:domain ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path rdfs:range ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 2 ;
        sh:uniqueLang true
    ] .

shape:StateDatatypePropertyShape
    a sh:NodeShape ;
    sh:targetSubjectsOf world:stateFieldCategory ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue owl:DatatypeProperty
    ] ;
    sh:property [
        sh:path rdfs:domain ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path rdfs:range ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 2 ;
        sh:uniqueLang true
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 2 ;
        sh:uniqueLang true
    ] ;
    sh:property [
        sh:path world:unitSymbol ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path world:stateFieldCategory ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

shape:aircraftAssignedToAirspaceExactDomainRangeShape
    a sh:NodeShape ;
    sh:targetNode dom:aircraftAssignedToAirspace ;
    sh:property [
        sh:path rdfs:domain ;
        sh:hasValue world:UnmannedAircraft
    ] ;
    sh:property [
        sh:path rdfs:range ;
        sh:hasValue dom:MissionAirspace
    ] .

shape:aircraftOccupiesCorridorExactDomainRangeShape
    a sh:NodeShape ;
    sh:targetNode dom:aircraftOccupiesCorridor ;
    sh:property [
        sh:path rdfs:domain ;
        sh:hasValue world:UnmannedAircraft
    ] ;
    sh:property [
        sh:path rdfs:range ;
        sh:hasValue world:AirspaceCorridor
    ] .

shape:airspaceConstrainedByRegionExactDomainRangeShape
    a sh:NodeShape ;
    sh:targetNode dom:airspaceConstrainedByRegion ;
    sh:property [
        sh:path rdfs:domain ;
        sh:hasValue dom:MissionAirspace
    ] ;
    sh:property [
        sh:path rdfs:range ;
        sh:hasValue dom:AirspaceConstraintRegion
    ] .

shape:AircraftInsideRestrictedAirspaceExactArgumentRolesShape
    a sh:NodeShape ;
    sh:targetNode dom:AircraftInsideRestrictedAirspace ;
    sh:property [
        sh:path aw:declaresArgumentRole ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:in ( dom:AircraftInsideRestrictedAirspaceArgument_actor dom:AircraftInsideRestrictedAirspaceArgument_restricted_region )
    ] .

shape:AircraftInsideProtectedAirspaceExactArgumentRolesShape
    a sh:NodeShape ;
    sh:targetNode dom:AircraftInsideProtectedAirspace ;
    sh:property [
        sh:path aw:declaresArgumentRole ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:in ( dom:AircraftInsideProtectedAirspaceArgument_aircraft dom:AircraftInsideProtectedAirspaceArgument_protected_region )
    ] .

shape:AircraftIsNonCooperativeExactArgumentRolesShape
    a sh:NodeShape ;
    sh:targetNode dom:AircraftIsNonCooperative ;
    sh:property [
        sh:path aw:declaresArgumentRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( dom:AircraftIsNonCooperativeArgument_aircraft )
    ] .

shape:AircraftOutsideAssignedAltitudeBandExactArgumentRolesShape
    a sh:NodeShape ;
    sh:targetNode dom:AircraftOutsideAssignedAltitudeBand ;
    sh:property [
        sh:path aw:declaresArgumentRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( dom:AircraftOutsideAssignedAltitudeBandArgument_actor )
    ] .

shape:AircraftOccupiesAirspaceCorridorExactArgumentRolesShape
    a sh:NodeShape ;
    sh:targetNode dom:AircraftOccupiesAirspaceCorridor ;
    sh:property [
        sh:path aw:declaresArgumentRole ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:in ( dom:AircraftOccupiesAirspaceCorridorArgument_actor dom:AircraftOccupiesAirspaceCorridorArgument_corridor )
    ] .

shape:AircraftMovingInCorridorExactArgumentRolesShape
    a sh:NodeShape ;
    sh:targetNode dom:AircraftMovingInCorridor ;
    sh:property [
        sh:path aw:declaresArgumentRole ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:in ( dom:AircraftMovingInCorridorArgument_actor dom:AircraftMovingInCorridorArgument_corridor )
    ] .

shape:AircraftStationaryInCorridorExactArgumentRolesShape
    a sh:NodeShape ;
    sh:targetNode dom:AircraftStationaryInCorridor ;
    sh:property [
        sh:path aw:declaresArgumentRole ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:in ( dom:AircraftStationaryInCorridorArgument_actor dom:AircraftStationaryInCorridorArgument_corridor )
    ] .

shape:AirspaceCorridorOverCapacityExactArgumentRolesShape
    a sh:NodeShape ;
    sh:targetNode dom:AirspaceCorridorOverCapacity ;
    sh:property [
        sh:path aw:declaresArgumentRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( dom:AirspaceCorridorOverCapacityArgument_corridor )
    ] .

shape:AircraftAirborneExactArgumentRolesShape
    a sh:NodeShape ;
    sh:targetNode dom:AircraftAirborne ;
    sh:property [
        sh:path aw:declaresArgumentRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( dom:AircraftAirborneArgument_aircraft )
    ] .

shape:AircraftAtHomePadExactArgumentRolesShape
    a sh:NodeShape ;
    sh:targetNode dom:AircraftAtHomePad ;
    sh:property [
        sh:path aw:declaresArgumentRole ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:in ( dom:AircraftAtHomePadArgument_aircraft dom:AircraftAtHomePadArgument_home_pad )
    ] .

shape:AircraftTouchdownExactArgumentRolesShape
    a sh:NodeShape ;
    sh:targetNode dom:AircraftTouchdown ;
    sh:property [
        sh:path aw:declaresArgumentRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( dom:AircraftTouchdownArgument_aircraft )
    ] .

shape:AircraftInLandingZoneExactArgumentRolesShape
    a sh:NodeShape ;
    sh:targetNode dom:AircraftInLandingZone ;
    sh:property [
        sh:path aw:declaresArgumentRole ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:in ( dom:AircraftInLandingZoneArgument_aircraft dom:AircraftInLandingZoneArgument_landing_zone )
    ] .
