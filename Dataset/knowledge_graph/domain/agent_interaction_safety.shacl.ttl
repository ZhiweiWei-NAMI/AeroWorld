@prefix aw: <https://w3id.org/aeroworld/ontology/core#> .
@prefix world: <https://w3id.org/aeroworld/ontology/world#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@prefix dom: <https://w3id.org/aeroworld/ontology/domain/agent_interaction_safety#> .
@prefix shape: <https://w3id.org/aeroworld/ontology/domain/agent_interaction_safety/shapes#> .

<https://w3id.org/aeroworld/ontology/domain/agent_interaction_safety/shapes>
    a owl:Ontology ;
    owl:imports <https://w3id.org/aeroworld/ontology/domain/agent_interaction_safety> ;
    owl:versionInfo "0.3.0" .

shape:PredicateSignatureShape
    a sh:NodeShape ;
    sh:targetClass aw:PredicateType ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        sh:path aw:predicateIdentifier ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path aw:declaresArgumentRole ;
        sh:class aw:ArgumentRole ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 2 ;
        sh:uniqueLang true
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 2 ;
        sh:uniqueLang true
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "One predicate cannot declare duplicate argument-role keys."@en ;
        sh:select """
            SELECT $this
            WHERE {
                $this aw:declaresArgumentRole ?left, ?right .
                ?left aw:argumentRoleKey ?key .
                ?right aw:argumentRoleKey ?key .
                FILTER (?left != ?right)
            }
        """
    ] .

shape:ArgumentRoleShape
    a sh:NodeShape ;
    sh:targetObjectsOf aw:declaresArgumentRole ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        sh:path aw:argumentRoleKey ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path world:argumentClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1
    ] .

shape:DomainClassShape
    a sh:NodeShape ;
    sh:targetSubjectsOf rdfs:subClassOf ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 2 ;
        sh:uniqueLang true
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 2 ;
        sh:uniqueLang true
    ] .

shape:DomainRelationShape
    a sh:NodeShape ;
    sh:targetClass owl:ObjectProperty ;
    sh:property [
        sh:path rdfs:domain ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path rdfs:range ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 2 ;
        sh:uniqueLang true
    ] .

shape:StateDatatypePropertyShape
    a sh:NodeShape ;
    sh:targetSubjectsOf world:stateFieldCategory ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue owl:DatatypeProperty
    ] ;
    sh:property [
        sh:path rdfs:domain ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path rdfs:range ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 2 ;
        sh:uniqueLang true
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 2 ;
        sh:uniqueLang true
    ] ;
    sh:property [
        sh:path world:unitSymbol ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path world:stateFieldCategory ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

shape:actorApproachesConflictPointExactDomainRangeShape
    a sh:NodeShape ;
    sh:targetNode dom:actorApproachesConflictPoint ;
    sh:property [
        sh:path rdfs:domain ;
        sh:hasValue world:MobileAgent
    ] ;
    sh:property [
        sh:path rdfs:range ;
        sh:hasValue dom:ConflictPoint
    ] .

shape:actorHasSafetySeparationVolumeExactDomainRangeShape
    a sh:NodeShape ;
    sh:targetNode dom:actorHasSafetySeparationVolume ;
    sh:property [
        sh:path rdfs:domain ;
        sh:hasValue world:MobileAgent
    ] ;
    sh:property [
        sh:path rdfs:range ;
        sh:hasValue dom:SafetySeparationVolume
    ] .

shape:safetyStateInvolvesActorExactDomainRangeShape
    a sh:NodeShape ;
    sh:targetNode dom:safetyStateInvolvesActor ;
    sh:property [
        sh:path rdfs:domain ;
        sh:hasValue world:EntityStateAtTick
    ] ;
    sh:property [
        sh:path rdfs:range ;
        sh:hasValue world:MobileAgent
    ] .

shape:AircraftPairBelowSeparationExactArgumentRolesShape
    a sh:NodeShape ;
    sh:targetNode dom:AircraftPairBelowSeparation ;
    sh:property [
        sh:path aw:declaresArgumentRole ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:in ( dom:AircraftPairBelowSeparationArgument_first_aircraft dom:AircraftPairBelowSeparationArgument_second_aircraft )
    ] .

shape:AircraftNearBuildingStructureExactArgumentRolesShape
    a sh:NodeShape ;
    sh:targetNode dom:AircraftNearBuildingStructure ;
    sh:property [
        sh:path aw:declaresArgumentRole ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:in ( dom:AircraftNearBuildingStructureArgument_aircraft dom:AircraftNearBuildingStructureArgument_structure )
    ] .

shape:AircraftNearGroundVehicleExactArgumentRolesShape
    a sh:NodeShape ;
    sh:targetNode dom:AircraftNearGroundVehicle ;
    sh:property [
        sh:path aw:declaresArgumentRole ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:in ( dom:AircraftNearGroundVehicleArgument_aircraft dom:AircraftNearGroundVehicleArgument_vehicle )
    ] .

shape:AircraftNearPedestrianExactArgumentRolesShape
    a sh:NodeShape ;
    sh:targetNode dom:AircraftNearPedestrian ;
    sh:property [
        sh:path aw:declaresArgumentRole ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:in ( dom:AircraftNearPedestrianArgument_aircraft dom:AircraftNearPedestrianArgument_pedestrian )
    ] .

shape:VehiclePedestrianConflictExactArgumentRolesShape
    a sh:NodeShape ;
    sh:targetNode dom:VehiclePedestrianConflict ;
    sh:property [
        sh:path aw:declaresArgumentRole ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:in ( dom:VehiclePedestrianConflictArgument_vehicle dom:VehiclePedestrianConflictArgument_pedestrian )
    ] .

shape:CrowdEvacuationActiveExactArgumentRolesShape
    a sh:NodeShape ;
    sh:targetNode dom:CrowdEvacuationActive ;
    sh:property [
        sh:path aw:declaresArgumentRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( dom:CrowdEvacuationActiveArgument_crowd )
    ] .

shape:ForcedLandingInPopulatedAreaExactArgumentRolesShape
    a sh:NodeShape ;
    sh:targetNode dom:ForcedLandingInPopulatedArea ;
    sh:property [
        sh:path aw:declaresArgumentRole ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:in ( dom:ForcedLandingInPopulatedAreaArgument_aircraft dom:ForcedLandingInPopulatedAreaArgument_populated_area )
    ] .
