@prefix aw: <https://w3id.org/aeroworld/ontology/core#> .
@prefix world: <https://w3id.org/aeroworld/ontology/world#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@prefix dom: <https://w3id.org/aeroworld/ontology/domain/ground_mobility#> .
@prefix shape: <https://w3id.org/aeroworld/ontology/domain/ground_mobility/shapes#> .

<https://w3id.org/aeroworld/ontology/domain/ground_mobility/shapes>
    a owl:Ontology ;
    owl:imports <https://w3id.org/aeroworld/ontology/domain/ground_mobility> ;
    owl:versionInfo "0.3.0" .

shape:PredicateSignatureShape
    a sh:NodeShape ;
    sh:targetClass aw:PredicateType ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        sh:path aw:predicateIdentifier ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path aw:declaresArgumentRole ;
        sh:class aw:ArgumentRole ;
        sh:minCount 1
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 2 ;
        sh:uniqueLang true
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 2 ;
        sh:uniqueLang true
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "One predicate cannot declare duplicate argument-role keys."@en ;
        sh:select """
            SELECT $this
            WHERE {
                $this aw:declaresArgumentRole ?left, ?right .
                ?left aw:argumentRoleKey ?key .
                ?right aw:argumentRoleKey ?key .
                FILTER (?left != ?right)
            }
        """
    ] .

shape:ArgumentRoleShape
    a sh:NodeShape ;
    sh:targetObjectsOf aw:declaresArgumentRole ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        sh:path aw:argumentRoleKey ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path world:argumentClass ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1
    ] .

shape:DomainClassShape
    a sh:NodeShape ;
    sh:targetSubjectsOf rdfs:subClassOf ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 2 ;
        sh:uniqueLang true
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 2 ;
        sh:uniqueLang true
    ] .

shape:DomainRelationShape
    a sh:NodeShape ;
    sh:targetClass owl:ObjectProperty ;
    sh:property [
        sh:path rdfs:domain ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path rdfs:range ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 2 ;
        sh:uniqueLang true
    ] .

shape:StateDatatypePropertyShape
    a sh:NodeShape ;
    sh:targetSubjectsOf world:stateFieldCategory ;
    sh:property [
        sh:path rdf:type ;
        sh:hasValue owl:DatatypeProperty
    ] ;
    sh:property [
        sh:path rdfs:domain ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path rdfs:range ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 2 ;
        sh:uniqueLang true
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 2 ;
        sh:uniqueLang true
    ] ;
    sh:property [
        sh:path world:unitSymbol ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path world:stateFieldCategory ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

shape:vehicleOccupiesLaneExactDomainRangeShape
    a sh:NodeShape ;
    sh:targetNode dom:vehicleOccupiesLane ;
    sh:property [
        sh:path rdfs:domain ;
        sh:hasValue world:GroundVehicle
    ] ;
    sh:property [
        sh:path rdfs:range ;
        sh:hasValue world:RoadLane
    ] .

shape:pedestrianOccupiesCrosswalkExactDomainRangeShape
    a sh:NodeShape ;
    sh:targetNode dom:pedestrianOccupiesCrosswalk ;
    sh:property [
        sh:path rdfs:domain ;
        sh:hasValue world:Pedestrian
    ] ;
    sh:property [
        sh:path rdfs:range ;
        sh:hasValue world:Crosswalk
    ] .

shape:detourAffectsRoadSegmentExactDomainRangeShape
    a sh:NodeShape ;
    sh:targetNode dom:detourAffectsRoadSegment ;
    sh:property [
        sh:path rdfs:domain ;
        sh:hasValue dom:RoadDetourState
    ] ;
    sh:property [
        sh:path rdfs:range ;
        sh:hasValue world:RoadSegment
    ] .

shape:vehicleTripHasActorExactDomainRangeShape
    a sh:NodeShape ;
    sh:targetNode dom:vehicleTripHasActor ;
    sh:property [
        sh:path rdfs:domain ;
        sh:hasValue dom:VehicleTrip
    ] ;
    sh:property [
        sh:path rdfs:range ;
        sh:hasValue world:GroundVehicle
    ] .

shape:pedestrianTripHasActorExactDomainRangeShape
    a sh:NodeShape ;
    sh:targetNode dom:pedestrianTripHasActor ;
    sh:property [
        sh:path rdfs:domain ;
        sh:hasValue dom:PedestrianTrip
    ] ;
    sh:property [
        sh:path rdfs:range ;
        sh:hasValue world:Pedestrian
    ] .

shape:tripUsesRoadElementExactDomainRangeShape
    a sh:NodeShape ;
    sh:targetNode dom:tripUsesRoadElement ;
    sh:property [
        sh:path rdfs:domain ;
        sh:hasValue dom:VehicleTrip
    ] ;
    sh:property [
        sh:path rdfs:range ;
        sh:hasValue world:RoadElement
    ] .

shape:VehicleMovingInLaneExactArgumentRolesShape
    a sh:NodeShape ;
    sh:targetNode dom:VehicleMovingInLane ;
    sh:property [
        sh:path aw:declaresArgumentRole ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:in ( dom:VehicleMovingInLaneArgument_vehicle dom:VehicleMovingInLaneArgument_lane )
    ] .

shape:VehicleStoppedInLaneExactArgumentRolesShape
    a sh:NodeShape ;
    sh:targetNode dom:VehicleStoppedInLane ;
    sh:property [
        sh:path aw:declaresArgumentRole ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:in ( dom:VehicleStoppedInLaneArgument_vehicle dom:VehicleStoppedInLaneArgument_lane )
    ] .

shape:VehicleQueueExceedsLengthExactArgumentRolesShape
    a sh:NodeShape ;
    sh:targetNode dom:VehicleQueueExceedsLength ;
    sh:property [
        sh:path aw:declaresArgumentRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( dom:VehicleQueueExceedsLengthArgument_road_element )
    ] .

shape:RoadSegmentClosedExactArgumentRolesShape
    a sh:NodeShape ;
    sh:targetNode dom:RoadSegmentClosed ;
    sh:property [
        sh:path aw:declaresArgumentRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( dom:RoadSegmentClosedArgument_road_segment )
    ] .

shape:PedestrianInCrosswalkExactArgumentRolesShape
    a sh:NodeShape ;
    sh:targetNode dom:PedestrianInCrosswalk ;
    sh:property [
        sh:path aw:declaresArgumentRole ;
        sh:minCount 2 ;
        sh:maxCount 2 ;
        sh:in ( dom:PedestrianInCrosswalkArgument_pedestrian dom:PedestrianInCrosswalkArgument_crosswalk )
    ] .

shape:TrafficSignalMalfunctionActiveExactArgumentRolesShape
    a sh:NodeShape ;
    sh:targetNode dom:TrafficSignalMalfunctionActive ;
    sh:property [
        sh:path aw:declaresArgumentRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( dom:TrafficSignalMalfunctionActiveArgument_signal )
    ] .
