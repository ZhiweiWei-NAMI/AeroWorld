    rdfs:range world:SpatialRegion ;
    rdfs:label "overlaps region"@en ,
        "与区域重叠"@zh ;
    skos:definition "States that two spatial regions geometrically overlap."@en ,
        "表示两个空间区域在几何上重叠。"@zh .


world:overlapsAirspaceRegion
    a owl:ObjectProperty ;
    rdfs:domain world:AirspaceCorridor ;
    rdfs:range world:AirspaceRegion ;
    rdfs:label "overlaps airspace region"@en ,
        "与空域区域重叠"@zh ;
    skos:definition "Relates an airspace corridor to an overlapping airspace region."@en ,
        "将空中航路关联到与其重叠的空域区域。"@zh .


world:hasEntityState
    a owl:ObjectProperty ;
    rdfs:domain aw:Entity ;
    rdfs:range world:EntityStateAtTick ;
    rdfs:label "has entity state"@en ,
        "具有实体状态"@zh ;
