    world:unitSymbol "m" ;
    world:stateFieldCategory "road-state" .

world:assignedAltitudeM
    a owl:DatatypeProperty ;
    rdfs:domain world:UnmannedAircraft ;
    rdfs:range xsd:decimal ;
    rdfs:label "assigned altitude in metres"@en ,
        "指定高度（米）"@zh ;
