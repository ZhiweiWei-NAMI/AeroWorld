world:lanePositionM
    a owl:DatatypeProperty ;
    rdfs:domain world:EntityStateAtTick ;
    rdfs:range xsd:decimal ;
    rdfs:label "lane position in metres"@en ,
        "车道位置（米）"@zh ;
