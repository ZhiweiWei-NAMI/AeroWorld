        "世界帧所属 episode"@zh ;
    skos:definition "Relates a world frame to the episode whose objective state it records."@en ,
        "将世界帧关联到其所记录客观状态所属的 episode。"@zh .


world:worldFrameAtInstant
    a owl:ObjectProperty ;
    rdfs:domain world:WorldFrame ;
    rdfs:range aw:TickInstant ;
    rdfs:label "world frame at instant"@en ,
        "世界帧时刻"@zh ;
    skos:definition "Relates a world frame to its exact simulation tick instant."@en ,
        "将世界帧关联到其精确仿真 tick 时刻。"@zh .


world:worldFrameUsesMap
    a owl:ObjectProperty ;
    rdfs:domain world:WorldFrame ;
    rdfs:range world:OperationalMap ;
    rdfs:label "world frame uses map"@en ,
        "世界帧使用地图"@zh ;
    skos:definition "Relates a world frame to the operational map in which its state is expressed."@en ,
        "将世界帧关联到表达其状态所使用的运行地图。"@zh .


world:worldFrameAtSite
    a owl:ObjectProperty ;
    rdfs:domain world:WorldFrame ;
    rdfs:range world:Site ;
    rdfs:label "world frame at site"@en ,
        "世界帧所在场地"@zh ;
    skos:definition "Relates a world frame to its active operational site."@en ,
        "将世界帧关联到其活动运行场地。"@zh .


world:worldFrameInRegionOfInterest
    a owl:ObjectProperty ;
    rdfs:domain world:WorldFrame ;
    rdfs:range world:RegionOfInterest ;
    rdfs:label "world frame in region of interest"@en ,
        "世界帧所在感兴趣区域"@zh ;
    skos:definition "Relates a world frame to its active region of interest."@en ,
        "将世界帧关联到其活动感兴趣区域。"@zh .


world:worldFrameCaptureBoundary
    a owl:ObjectProperty ;
