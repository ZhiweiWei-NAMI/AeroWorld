        "世界帧包含实体状态"@zh ;
    skos:definition "Relates a world frame to an entity state contained in that frame."@en ,
        "将世界帧关联到该帧包含的实体状态。"@zh .


world:entityStateInFrame
    a owl:ObjectProperty ;
    rdfs:domain world:EntityStateAtTick ;
    rdfs:range world:WorldFrame ;
    rdfs:label "entity state in frame"@en ,
        "实体状态所属世界帧"@zh ;
    skos:definition "Relates an entity state to the world frame containing it."@en ,
        "将实体状态关联到包含它的世界帧。"@zh .


world:stateOfEntity
    a owl:ObjectProperty ;
    rdfs:domain world:EntityStateAtTick ;
    rdfs:range aw:Entity ;
    rdfs:label "state of entity"@en ,
        "所描述实体"@zh ;
    skos:definition "Identifies the stable entity described by a state record."@en ,
        "标识状态记录所描述的稳定实体。"@zh .


world:stateAtInstant
    a owl:ObjectProperty ;
    rdfs:domain world:EntityStateAtTick ;
    rdfs:range aw:TickInstant ;
    rdfs:label "state at instant"@en ,
        "状态时刻"@zh ;
    skos:definition "Relates an entity state record to its exact simulation tick instant."@en ,
        "将实体状态记录关联到精确的仿真 tick 时刻。"@zh .


world:stateInRegion
    a owl:ObjectProperty ;
    rdfs:domain world:EntityStateAtTick ;
    rdfs:range world:SpatialRegion ;
    rdfs:label "state in region"@en ,
        "状态所在区域"@zh ;
    skos:definition "Relates an entity state to a spatial region containing its objective position."@en ,
        "将实体状态关联到包含其客观位置的空间区域。"@zh .


world:stateOnRoadLane
    a owl:ObjectProperty ;
