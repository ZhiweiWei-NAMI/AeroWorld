    rdfs:range world:RoadLane ;
    rdfs:label "state on road lane"@en ,
        "状态所在车道"@zh ;
    skos:definition "Relates an entity state to the road lane occupied at that tick."@en ,
        "将实体状态关联到该 tick 所占用的道路车道。"@zh .


world:stateInAirspaceCorridor
    a owl:ObjectProperty ;
    rdfs:domain world:EntityStateAtTick ;
    rdfs:range world:AirspaceCorridor ;
    rdfs:label "state in airspace corridor"@en ,
        "状态所在空中航路"@zh ;
    skos:definition "Relates an aircraft state to the airspace corridor occupied at that tick."@en ,
        "将航空器状态关联到该 tick 所在的空中航路。"@zh .


world:roadHasSegment
    a owl:ObjectProperty ;
    rdfs:domain world:Roadway ;
    rdfs:range world:RoadSegment ;
    rdfs:label "road has segment"@en ,
        "道路具有路段"@zh ;
    skos:definition "Relates a roadway to one of its constituent segments."@en ,
        "将道路关联到其组成路段。"@zh .


world:mapHasStaticFeature
    a owl:ObjectProperty ;
    rdfs:domain world:OperationalMap ;
    rdfs:range world:StaticMapFeature ;
    rdfs:label "map has static feature"@en ,
        "地图具有静态要素"@zh ;
    skos:definition "Relates an operational map to a static feature summarized from its authoritative source data."@en ,
        "将运行地图关联到从其权威源数据摘要得到的静态要素。"@zh .


world:staticFeatureInMap
    a owl:ObjectProperty ;
    rdfs:domain world:StaticMapFeature ;
    rdfs:range world:OperationalMap ;
    rdfs:label "static feature in map"@en ,
        "静态要素所在地图"@zh ;
    skos:definition "Relates a static map feature to the operational map that contains it."@en ,
        "将静态地图要素关联到包含它的运行地图。"@zh .



world:segmentHasLane
    a owl:ObjectProperty ;
    rdfs:domain world:RoadSegment ;
    rdfs:range world:RoadLane ;
    rdfs:label "segment has lane"@en ,
        "路段具有车道"@zh ;
    skos:definition "Relates a road segment to one of its directed lanes."@en ,
        "将道路路段关联到其有向车道。"@zh .



world:laneConnectsTo
    a owl:ObjectProperty ;
    rdfs:domain world:RoadLane ;
    rdfs:range world:RoadLane ;
    rdfs:label "lane connects to"@en ,
        "车道连接到"@zh ;
    skos:definition "Relates a directed road lane to an immediately reachable lane."@en ,
        "将有向道路车道关联到可直接到达的车道。"@zh .


world:roadMeetsAtIntersection
    a owl:ObjectProperty ;
    rdfs:domain world:RoadSegment ;
    rdfs:range world:Intersection ;
    rdfs:label "road meets at intersection"@en ,
