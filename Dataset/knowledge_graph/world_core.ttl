    world:unitSymbol "m/s^2" ;
    world:stateFieldCategory "motion-state" .

world:activityType
    a owl:DatatypeProperty ;
    rdfs:domain world:EntityStateAtTick ;
    rdfs:range xsd:string ;
    rdfs:label "activity type"@en ,
        "活动类型"@zh ;
    skos:definition "The objective activity_type assigned to an entity at a tick."@en ,
        "在某一 tick 分配给实体的客观 activity_type。"@zh ;
    world:unitSymbol "state-code" ;
    world:stateFieldCategory "activity-state" .

world:operationalState
    a owl:DatatypeProperty ;
