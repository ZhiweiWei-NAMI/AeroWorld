    skos:definition "Relates a world frame to its objective capture boundary."@en ,
        "将世界帧关联到其客观采集边界。"@zh .


world:frameContainsEntityState
    a owl:ObjectProperty ;
    rdfs:domain world:WorldFrame ;
    rdfs:range world:EntityStateAtTick ;
