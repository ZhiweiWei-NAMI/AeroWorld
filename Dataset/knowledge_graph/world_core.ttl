    skos:definition "Relates a road segment to an intersection it enters or leaves."@en ,
        "将道路路段关联到其进入或离开的路口。"@zh .


world:controlsIntersection
    a owl:ObjectProperty ;
    rdfs:domain world:TrafficSignal ;
    rdfs:range world:Intersection ;
    rdfs:label "controls intersection"@en ,
        "控制路口"@zh ;
    skos:definition "Relates a traffic signal to the intersection it controls."@en ,
        "将交通信号灯关联到其控制的路口。"@zh .


world:pedestrianUsesCrosswalk
    a owl:ObjectProperty ;
    rdfs:domain world:Pedestrian ;
    rdfs:range world:Crosswalk ;
    rdfs:label "pedestrian uses crosswalk"@en ,
        "行人使用人行横道"@zh ;
    skos:definition "Relates a pedestrian to a crosswalk assigned to its movement."@en ,
        "将行人关联到其运动所使用的人行横道。"@zh .


world:assignedToCorridor
    a owl:ObjectProperty ;
    rdfs:domain world:UnmannedAircraft ;
    rdfs:range world:AirspaceCorridor ;
    rdfs:label "assigned to corridor"@en ,
        "分配至航路"@zh ;
    skos:definition "Relates an aircraft to its assigned airspace corridor."@en ,
        "将航空器关联到其指定空中航路。"@zh .


world:assignedAltitudeBand
    a owl:ObjectProperty ;
    rdfs:domain world:UnmannedAircraft ;
    rdfs:range world:AltitudeBand ;
    rdfs:label "assigned altitude band"@en ,
        "指定高度层"@zh ;
    skos:definition "Relates an aircraft to its assigned altitude band."@en ,
        "将航空器关联到其指定高度层。"@zh .


world:hasHomeLandingSite
    a owl:ObjectProperty ;
    rdfs:domain world:UnmannedAircraft ;
    rdfs:range world:LandingSite ;
    rdfs:label "has home landing site"@en ,
        "具有归航场地"@zh ;
    skos:definition "Relates an aircraft to its home or recovery landing site."@en ,
        "将航空器关联到其归航或恢复场地。"@zh .


world:servedByStation
    a owl:ObjectProperty ;
    rdfs:domain world:UnmannedAircraft ;
    rdfs:range world:CommunicationStation ;
    rdfs:label "served by station"@en ,
        "由通信站服务"@zh ;
    skos:definition "Relates an aircraft to a communication station serving it."@en ,
        "将航空器关联到为其服务的通信站。"@zh .


world:assignedChargingStation
    a owl:ObjectProperty ;
    rdfs:domain world:UnmannedAircraft ;
    rdfs:range world:ChargingStation ;
    rdfs:label "assigned charging station"@en ,
        "指定充电站"@zh ;
    skos:definition "Relates an aircraft to its assigned charging station."@en ,
        "将航空器关联到其指定充电站。"@zh .


world:requestsUseOf
    a owl:ObjectProperty ;
    rdfs:domain world:UnmannedAircraft ;
    rdfs:range world:InfrastructureAsset ;
    rdfs:label "requests use of"@en ,
        "请求使用"@zh ;
    skos:definition "Relates an aircraft to an infrastructure resource it requests."@en ,
        "将航空器关联到其请求使用的基础设施资源。"@zh .


world:assignedResponderTo
    a owl:ObjectProperty ;
    rdfs:domain world:EmergencyResponder ;
    rdfs:range world:HazardSource ;
    rdfs:label "assigned responder to"@en ,
        "响应主体被指派至"@zh ;
    skos:definition "Relates an emergency responder to the hazard or incident it is assigned to."@en ,
        "将应急响应主体关联到其被指派处理的危险或事件。"@zh .


world:landingOccursIn
    a owl:ObjectProperty ;
    rdfs:domain world:UnmannedAircraft ;
    rdfs:range world:LandingArea ;
    rdfs:label "landing occurs in"@en ,
        "降落发生于"@zh ;
    skos:definition "Relates an aircraft to the operational region of its landing."@en ,
        "将航空器关联到其降落所在的运行区域。"@zh .


world:carriesPayload
    a owl:ObjectProperty ;
    rdfs:domain world:MobileAgent ;
    rdfs:range world:Payload ;
    rdfs:label "carries payload"@en ,
        "携带载荷"@zh ;
    skos:definition "Relates a mobile agent to a physical payload it carries."@en ,
        "将移动主体关联到其携带的物理载荷。"@zh .


world:controlledBy
    a owl:ObjectProperty ;
    rdfs:domain world:UnmannedAircraft ;
    rdfs:range world:GroundControlStation ;
    rdfs:label "controlled by"@en ,
        "由地面控制站控制"@zh ;
    skos:definition "Relates an aircraft to its controlling ground control station."@en ,
        "将航空器关联到控制其运行的地面控制站。"@zh .


#################################################################
# Shared world datatype properties
#################################################################

world:logicalAssetIdentifier
    a owl:DatatypeProperty ;
    rdfs:domain aw:Entity ;
    rdfs:range xsd:string ;
    rdfs:label "logical asset identifier"@en ,
        "逻辑资产标识"@zh ;
    skos:definition "The stable logical asset identifier assigned to an episode entity."@en ,
        "分配给 episode 实体的稳定逻辑资产标识。"@zh ;
    world:unitSymbol "identifier" ;
    world:stateFieldCategory "entity-identifier" .

world:siteIdentifier
    a owl:DatatypeProperty ;
    rdfs:domain world:Site ;
    rdfs:range xsd:string ;
    rdfs:label "site identifier"@en ,
        "场地标识"@zh ;
    skos:definition "The stable site_id value used by episode artifacts."@en ,
        "episode 制品使用的稳定 site_id 值。"@zh ;
    world:unitSymbol "identifier" ;
    world:stateFieldCategory "spatial-identifier" .

world:regionOfInterestIdentifier
    a owl:DatatypeProperty ;
    rdfs:domain world:RegionOfInterest ;
    rdfs:range xsd:string ;
    rdfs:label "region of interest identifier"@en ,
        "感兴趣区域标识"@zh ;
    skos:definition "The stable roi_id value used by episode artifacts."@en ,
        "episode 制品使用的稳定 roi_id 值。"@zh ;
    world:unitSymbol "identifier" ;
    world:stateFieldCategory "spatial-identifier" .

world:boundaryIdentifier
    a owl:DatatypeProperty ;
    rdfs:domain world:SpatialBoundary ;
    rdfs:range xsd:string ;
    rdfs:label "boundary identifier"@en ,
        "边界标识"@zh ;
    skos:definition "The stable capture_boundary_id value used by episode truth."@en ,
        "episode 真值使用的稳定 capture_boundary_id 值。"@zh ;
    world:unitSymbol "identifier" ;
    world:stateFieldCategory "spatial-identifier" .

world:mapIdentifier
    a owl:DatatypeProperty ;
    rdfs:domain world:OperationalMap ;
    rdfs:range xsd:string ;
    rdfs:label "map identifier"@en ,
        "地图标识"@zh ;
    skos:definition "The stable map_id value used by episode truth."@en ,
        "episode 真值使用的稳定 map_id 值。"@zh ;
    world:unitSymbol "identifier" ;
    world:stateFieldCategory "map-identifier" .

world:staticMapGraphIdentifier
    a owl:DatatypeProperty ;
    rdfs:domain world:OperationalMap ;
    rdfs:range xsd:string ;
    rdfs:label "static map graph identifier"@en ,
        "静态地图图标识"@zh ;
    skos:definition "The stable identifier of the one-time static semantic graph for an operational map."@en ,
        "运行地图一次性静态语义图的稳定标识。"@zh ;
    world:unitSymbol "identifier" ;
    world:stateFieldCategory "map-identifier" .

world:staticFeatureIdentifier
    a owl:DatatypeProperty ;
    rdfs:domain world:StaticMapFeature ;
    rdfs:range xsd:string ;
    rdfs:label "static feature identifier"@en ,
        "静态要素标识"@zh ;
    skos:definition "The deterministic identifier assigned to a static map feature in the generated map graph."@en ,
        "生成的地图图中分配给静态地图要素的确定性标识。"@zh ;
    world:unitSymbol "identifier" ;
    world:stateFieldCategory "map-feature-identifier" .

world:sourceFeatureIdentifier
    a owl:DatatypeProperty ;
    rdfs:domain world:StaticMapFeature ;
    rdfs:range xsd:string ;
    rdfs:label "source feature identifier"@en ,
        "源要素标识"@zh ;
    skos:definition "The feature identifier retained from the authoritative source feature record when available."@en ,
        "在可用时从权威源要素记录保留的要素标识。"@zh ;
    world:unitSymbol "identifier" ;
    world:stateFieldCategory "source-feature-identifier" .

world:sourceFeatureLayer
    a owl:DatatypeProperty ;
    rdfs:domain world:StaticMapFeature ;
    rdfs:range xsd:string ;
    rdfs:label "source feature layer"@en ,
        "源要素图层"@zh ;
    skos:definition "The authoritative static map layer from which the feature was read."@en ,
        "读取该要素的权威静态地图图层。"@zh ;
    world:unitSymbol "layer" ;
    world:stateFieldCategory "source-feature-identifier" .

world:sourceFeatureLocator
    a owl:DatatypeProperty ;
    rdfs:domain world:StaticMapFeature ;
    rdfs:range xsd:string ;
    rdfs:label "source feature locator"@en ,
        "源要素定位符"@zh ;
    skos:definition "A deterministic locator for the authoritative source file and feature index."@en ,
        "权威源文件和要素索引的确定性定位符。"@zh ;
    world:unitSymbol "locator" ;
    world:stateFieldCategory "source-feature-identifier" .

world:sourceGeometryType
    a owl:DatatypeProperty ;
    rdfs:domain world:StaticMapFeature ;
    rdfs:range xsd:string ;
    rdfs:label "source geometry type"@en ,
        "源几何类型"@zh ;
    skos:definition "The GeoJSON geometry type of the authoritative source feature."@en ,
        "权威源要素的 GeoJSON 几何类型。"@zh ;
    world:unitSymbol "geojson-type" ;
    world:stateFieldCategory "source-geometry-summary" .

world:sourceGeometryDigest
    a owl:DatatypeProperty ;
    rdfs:domain world:StaticMapFeature ;
    rdfs:range xsd:string ;
    rdfs:label "source geometry digest"@en ,
        "源几何摘要"@zh ;
    skos:definition "The stable digest of the authoritative source geometry used instead of copying full geometry into graph outputs."@en ,
        "权威源几何的稳定摘要，用于避免在图输出中复制完整几何。"@zh ;
    world:unitSymbol "sha256" ;
    world:stateFieldCategory "source-geometry-summary" .

world:sourceGeometryBbox
    a owl:DatatypeProperty ;
    rdfs:domain world:StaticMapFeature ;
    rdfs:range xsd:string ;
    rdfs:label "source geometry bounding box"@en ,
        "源几何包围盒"@zh ;
    skos:definition "The two-dimensional source geometry bounding box serialized as a deterministic JSON array."@en ,
        "以确定性 JSON 数组序列化的二维源几何包围盒。"@zh ;
    world:unitSymbol "source-coordinate-array" ;
    world:stateFieldCategory "source-geometry-summary" .

world:sourceGeometryCentroid
    a owl:DatatypeProperty ;
    rdfs:domain world:StaticMapFeature ;
    rdfs:range xsd:string ;
    rdfs:label "source geometry centroid"@en ,
        "源几何中心点"@zh ;
    skos:definition "The two-dimensional source geometry centroid serialized as a deterministic JSON array."@en ,
        "以确定性 JSON 数组序列化的二维源几何中心点。"@zh ;
    world:unitSymbol "source-coordinate-array" ;
    world:stateFieldCategory "source-geometry-summary" .

world:sourcePropertiesDigest
    a owl:DatatypeProperty ;
    rdfs:domain world:StaticMapFeature ;
    rdfs:range xsd:string ;
    rdfs:label "source properties digest"@en ,
        "源属性摘要"@zh ;
    skos:definition "The stable digest of retained non-null source feature properties."@en ,
        "保留的非空源要素属性的稳定摘要。"@zh ;
    world:unitSymbol "sha256" ;
    world:stateFieldCategory "source-feature-properties" .

world:frameIdentifier
    a owl:DatatypeProperty ;
    rdfs:domain world:WorldFrame ;
    rdfs:range xsd:string ;
    rdfs:label "frame identifier"@en ,
        "世界帧标识"@zh ;
    skos:definition "The stable frame_id value used by episode truth."@en ,
        "episode 真值使用的稳定 frame_id 值。"@zh ;
    world:unitSymbol "identifier" ;
    world:stateFieldCategory "frame-identifier" .

world:roadIdentifier
    a owl:DatatypeProperty ;
    rdfs:domain world:Roadway ;
    rdfs:range xsd:string ;
    rdfs:label "road identifier"@en ,
        "道路标识"@zh ;
    skos:definition "The stable source road identifier."@en ,
        "稳定的源道路标识。"@zh ;
    world:unitSymbol "identifier" ;
    world:stateFieldCategory "road-identifier" .

world:roadEdgeIdentifier
    a owl:DatatypeProperty ;
    rdfs:domain world:RoadSegment ;
    rdfs:range xsd:string ;
    rdfs:label "road edge identifier"@en ,
        "道路边标识"@zh ;
    skos:definition "The stable directed edge identifier used by road and SUMO truth."@en ,
        "道路与 SUMO 真值使用的稳定有向边标识。"@zh ;
    world:unitSymbol "identifier" ;
    world:stateFieldCategory "road-identifier" .

world:roadLaneIdentifier
    a owl:DatatypeProperty ;
    rdfs:domain world:RoadLane ;
    rdfs:range xsd:string ;
    rdfs:label "road lane identifier"@en ,
        "道路车道标识"@zh ;
    skos:definition "The stable directed lane identifier used by road and SUMO truth."@en ,
        "道路与 SUMO 真值使用的稳定有向车道标识。"@zh ;
    world:unitSymbol "identifier" ;
    world:stateFieldCategory "road-identifier" .

world:laneIndex
    a owl:DatatypeProperty ;
    rdfs:domain world:RoadLane ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "lane index"@en ,
        "车道索引"@zh ;
    skos:definition "The zero-based lane index within a directed road edge."@en ,
        "有向道路边内从零开始的车道索引。"@zh ;
    world:unitSymbol "1" ;
    world:stateFieldCategory "topology-index" .

world:laneWidthM
    a owl:DatatypeProperty ;
    rdfs:domain world:RoadLane ;
    rdfs:range xsd:decimal ;
    rdfs:label "lane width in metres"@en ,
        "车道宽度（米）"@zh ;
    skos:definition "The physical width of a road lane in metres."@en ,
        "道路车道的物理宽度，单位为米。"@zh ;
    world:unitSymbol "m" ;
    world:stateFieldCategory "topology-metric" .

world:laneSpeedLimitMps
    a owl:DatatypeProperty ;
    rdfs:domain world:RoadLane ;
    rdfs:range xsd:decimal ;
    rdfs:label "lane speed limit in metres per second"@en ,
        "车道限速（米每秒）"@zh ;
    skos:definition "The lane speed value in metres per second."@en ,
        "车道速度值，单位为米每秒。"@zh ;
    world:unitSymbol "m/s" ;
    world:stateFieldCategory "topology-metric" .

world:positionEastM
