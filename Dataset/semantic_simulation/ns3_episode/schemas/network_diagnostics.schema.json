{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aeroworld:p01:ns3:v1:network_diagnostics",
  "title": "network_diagnostics",
  "type": "object",
  "properties": {
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "producer_version": {
      "const": "p01.ns3.v1"
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "config_ref": {
      "const": "run_config.json"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "life_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "const": "KNOWN"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "units": {
      "type": "object",
      "required": [
        "time"
      ],
      "properties": {
        "time": {
          "const": "ns"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "dimensions": {
      "type": "object",
      "required": [
        "time"
      ],
      "properties": {
        "time": {
          "const": "time"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "time_support": {
      "type": "object",
      "required": [
        "start_ns",
        "end_ns",
        "end_exclusive"
      ],
      "properties": {
        "start_ns": {
          "type": "integer",
          "minimum": 0
        },
        "end_ns": {
          "type": "integer",
          "minimum": 0
        },
        "end_exclusive": {
          "type": "boolean"
        },
        "anchor": {
          "const": "packet_expiry_ns"
        },
        "ttl_ns": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "packet_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "enum": [
        "phy_tx_begin",
        "phy_tx_retry",
        "phy_tx_drop",
        "phy_rx_drop",
        "mac_drop",
        "mac_response_timeout"
      ]
    },
    "scope": {
      "enum": [
        "tagged_endpoint",
        "tagged_overheard",
        "untagged_control_or_unidentified"
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 1
    },
    "first_time_ns": {
      "type": "integer",
      "minimum": 0
    },
    "last_time_ns": {
      "type": "integer",
      "minimum": 0
    },
    "reason_status": {
      "enum": [
        "KNOWN",
        "UNKNOWN"
      ]
    }
  },
  "required": [
    "episode_id",
    "producer_version",
    "source_ref",
    "config_ref",
    "owner",
    "life_epoch",
    "status",
    "reason",
    "units",
    "dimensions",
    "time_support",
    "node_id",
    "packet_id",
    "kind",
    "scope",
    "count",
    "first_time_ns",
    "last_time_ns",
    "reason_status"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "reason_status": {
            "const": "UNKNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason_status": {
            "const": "KNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "type": "string"
          }
        }
      }
    }
  ],
  "$comment": "Counts aggregate observed callbacks, not unique lost datagrams. Preserve endpoint, overheard, and untagged scope separately; no loss-cause inference from uncaptured events."
}
