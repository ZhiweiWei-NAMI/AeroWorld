          "type": "integer",
          "minimum": 0
        },
        "end_ns": {
          "type": "integer",
          "minimum": 0
        },
        "end_exclusive": {
          "type": "boolean"
        },
        "anchor": {
          "const": "packet_expiry_ns"
        },
        "ttl_ns": {
          "type": "integer",
          "minimum": 0
        }
