{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aeroworld:p01:ns3:v1:network_queue_sample",
  "title": "network_queue_sample",
  "type": "object",
  "properties": {
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "producer_version": {
      "const": "p01.ns3.v1"
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "config_ref": {
      "const": "run_config.json"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "life_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "units": {
      "type": "object",
      "required": [
        "time"
      ],
      "properties": {
        "time": {
          "const": "ns"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "dimensions": {
      "type": "object",
      "required": [
        "time"
      ],
      "properties": {
        "time": {
          "const": "time"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "time_support": {
      "type": "object",
      "required": [
        "start_ns",
        "end_ns",
        "end_exclusive"
      ],
      "properties": {
        "start_ns": {
          "type": "integer",
          "minimum": 0
        },
        "end_ns": {
          "type": "integer",
          "minimum": 0
        },
        "end_exclusive": {
          "type": "boolean"
        },
        "anchor": {
          "const": "packet_expiry_ns"
        },
        "ttl_ns": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "time_ns": {
      "type": "integer",
      "minimum": 0
    },
    "queue_packets": {
      "type": "integer",
      "minimum": 0
    },
    "queue_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "observed_until_ns": {
      "type": "integer",
      "minimum": -1,
      "description": "Signed integer ns; -1 is the initial device snapshot before t0 applications, later observations execute at time_ns-1."
    }
  },
  "required": [
    "episode_id",
    "producer_version",
    "source_ref",
    "config_ref",
    "owner",
    "life_epoch",
    "status",
    "reason",
    "units",
    "dimensions",
    "time_support",
    "node_id",
    "time_ns",
    "queue_packets",
    "queue_bytes",
    "observed_until_ns"
  ],
  "additionalProperties": false
}
