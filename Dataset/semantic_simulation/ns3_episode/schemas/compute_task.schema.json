{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aeroworld:p01:ns3:v1:compute_task",
  "title": "compute_task",
  "type": "object",
  "properties": {
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "producer_version": {
      "const": "p01.ns3.v1"
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "config_ref": {
      "const": "run_config.json"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "life_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "units": {
      "type": "object",
      "required": [
        "time"
      ],
      "properties": {
        "time": {
          "const": "ns"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "dimensions": {
      "type": "object",
      "required": [
        "time"
      ],
      "properties": {
        "time": {
          "const": "time"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "time_support": {
      "type": "object",
      "required": [
        "start_ns",
        "end_ns",
        "end_exclusive"
      ],
      "properties": {
        "start_ns": {
          "type": "integer",
          "minimum": 0
        },
        "end_ns": {
          "type": "integer",
          "minimum": 0
        },
        "end_exclusive": {
          "type": "boolean"
        },
        "anchor": {
          "const": "packet_expiry_ns"
        },
        "ttl_ns": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "executor_node_id": {
      "type": "string",
      "minLength": 1
    },
    "arrival_ns": {
      "type": "integer",
      "minimum": 0
    },
    "deadline_ns": {
      "type": "integer",
      "minimum": 0
    },
    "start_ns": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "completion_ns": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "terminal_ns": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "service_ns": {
      "type": "integer",
      "minimum": 0
    },
    "wait_ns": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "cycles": {
      "type": "integer",
      "minimum": 0
    },
    "memory_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "deadline_missed": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "deadline_missed_status": {
      "enum": [
        "KNOWN",
        "UNKNOWN",
        "OUT_OF_SCOPE"
      ]
    },
    "deadline_missed_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "deadline_missed_available_ns": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "required": [
    "episode_id",
    "producer_version",
    "source_ref",
    "config_ref",
    "owner",
    "life_epoch",
    "status",
    "reason",
    "units",
    "dimensions",
    "time_support",
    "task_id",
    "executor_node_id",
    "arrival_ns",
    "deadline_ns",
    "start_ns",
    "completion_ns",
    "terminal_ns",
    "service_ns",
    "wait_ns",
    "cycles",
    "memory_bytes",
    "deadline_missed",
    "deadline_missed_status",
    "deadline_missed_reason",
    "deadline_missed_available_ns"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "deadline_missed_status": {
            "const": "KNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "deadline_missed": {
            "type": "boolean"
          },
          "deadline_missed_reason": {
            "type": "null"
          },
          "deadline_missed_available_ns": {
            "type": "integer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "deadline_missed_status": {
            "enum": [
              "UNKNOWN",
              "OUT_OF_SCOPE"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "deadline_missed": {
            "type": "null"
          },
          "deadline_missed_reason": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "deadline_missed_status": {
            "const": "UNKNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "deadline_missed_available_ns": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "deadline_missed_status": {
            "const": "OUT_OF_SCOPE"
          }
        }
      },
      "then": {
        "properties": {
          "deadline_missed_available_ns": {
            "type": "integer"
          }
        }
      }
    }
  ]
}
