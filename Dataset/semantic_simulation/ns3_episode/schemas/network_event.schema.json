{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aeroworld:p01:ns3:v1:network_event",
  "title": "network_event",
  "type": "object",
  "properties": {
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "producer_version": {
      "const": "p01.ns3.v1"
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "config_ref": {
      "const": "run_config.json"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "life_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "units": {
      "type": "object",
      "required": [
        "time"
      ],
      "properties": {
        "time": {
          "const": "ns"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "dimensions": {
      "type": "object",
      "required": [
        "time"
      ],
      "properties": {
        "time": {
          "const": "time"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "time_support": {
      "type": "object",
      "required": [
        "start_ns",
        "end_ns",
        "end_exclusive"
      ],
      "properties": {
        "start_ns": {
          "type": "integer",
          "minimum": 0
        },
        "end_ns": {
          "type": "integer",
          "minimum": 0
        },
        "end_exclusive": {
          "type": "boolean"
        },
        "anchor": {
          "const": "packet_expiry_ns"
        },
        "ttl_ns": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "link_id": {
      "type": "string",
      "minLength": 1
    },
    "src_node_id": {
      "type": "string",
      "minLength": 1
    },
    "dst_node_id": {
      "type": "string",
      "minLength": 1
    },
    "flow_id": {
      "type": "string",
      "minLength": 1
    },
    "payload_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "time_ns": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "episode_id",
    "producer_version",
    "source_ref",
    "config_ref",
    "owner",
    "life_epoch",
    "status",
    "reason",
    "units",
    "dimensions",
    "time_support",
    "event_id",
    "event_type",
    "time_ns",
    "packet_id",
    "link_id",
    "src_node_id",
    "dst_node_id",
    "flow_id"
  ],
  "additionalProperties": true
}
